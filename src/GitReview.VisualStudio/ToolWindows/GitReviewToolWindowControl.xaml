<UserControl x:Class="GitReview.VisualStudio.ToolWindows.GitReviewToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="400"
             MinHeight="500">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock
                Text="GitReview"
                FontSize="24"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="AI-powered code review"
                Opacity="0.7"
                Margin="0,4,0,0"/>

        </StackPanel>


        <!-- Provider -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,12">

            <TextBlock
                Text="Provider"
                Margin="0,0,0,5"/>

            <ComboBox
                x:Name="ProviderComboBox"
                Height="30"
                SelectedIndex="0">

                <ComboBoxItem Content="OpenRouter"/>
                <ComboBoxItem Content="Gemini"/>
                <ComboBoxItem Content="DeepSeek"/>

            </ComboBox>

        </StackPanel>


        <!-- Model -->

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,12">

            <TextBlock
                Text="Model"
                Margin="0,0,0,5"/>

            <TextBox
                x:Name="ModelTextBox"
                Height="30"
                Text=""/>

        </StackPanel>


        <!-- Scope -->

        <StackPanel Grid.Row="3"
                    Margin="0,0,0,16">

            <TextBlock
                Text="Review"
                Margin="0,0,0,5"/>

            <ComboBox
                x:Name="ScopeComboBox"
                Height="30"
                SelectedIndex="0">

                <ComboBoxItem Content="Working changes"/>
                <ComboBoxItem Content="Staged changes"/>
                <ComboBoxItem Content="Current branch"/>

            </ComboBox>

        </StackPanel>


        <!-- Button -->

        <Button
            x:Name="ReviewButton"
            Grid.Row="4"
            Content="Review Changes"
            Height="34"
            HorizontalAlignment="Stretch"
            Click="ReviewButton_Click"/>


        <!-- Results -->

        <Grid Grid.Row="5"
              Margin="0,20,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Results"
                FontSize="18"
                FontWeight="SemiBold"
                Margin="0,0,0,10"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="ResultsPanel">

                    <TextBlock
                        x:Name="EmptyStateText"
                        Text="Run a review to see findings."
                        Opacity="0.6"
                        TextWrapping="Wrap"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</UserControl>